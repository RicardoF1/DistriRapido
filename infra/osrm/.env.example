# Example only. Do not replace the existing project .env.
# Set values in the shell or a private configuration file after approval.
# OSRM_IMAGE must be a verified release tag or ghcr.io/project-osrm/osrm-backend@sha256:...
OSRM_IMAGE=
OSRM_DATA_DIR=
OSRM_GRAPH_BASE=huancayo
OSRM_DATA_REVISION=
OSRM_BASE_URL=http://osrm:5000
OSRM_ALLOWED_ORIGIN=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=10000
OSRM_TOTAL_TIMEOUT_MS=20000
OSRM_MAX_SNAP_M=100
# Initial test limits, not a measured production sizing recommendation.
OSRM_CPUS=2
OSRM_MEMORY_LIMIT=2g
